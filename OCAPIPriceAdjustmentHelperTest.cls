                System.assert(sfccProd.isComp, 'Error: RJES-20-MM-ENG should have been marked as Comp but it was not.');
            }else{
                System.assert(!sfccProd.isComp, 'Error: Product ' + sfccProd.sku + ' was marked as comp but should not have been.');
            }
        }
    }
}