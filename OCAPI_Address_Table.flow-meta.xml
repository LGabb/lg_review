    <decisions>
        <name>Check_Address_Selection</name>
        <label>Check Address Selection</label>
        <locationX>270</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Set_Selected_Address_to_Billing_Address</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default - Address Selected</defaultConnectorLabel>
        <rules>
            <name>New_Address</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Select_an_existing_address_bill</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AddressNotInTable</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Select_an_existing_address_ship</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AddressNotInTable</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Select_an_existing_address_skip_ship</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AddressNotInTable</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_No_Address_Variable</targetReference>
            </connector>
            <label>New Address</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_Address_Selected_Check</name>
        <label>No Address Selected Check</label>
        <locationX>490</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Set_Same_Billing_And_Shipping_Variable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default - Address Selected</defaultConnectorLabel>
        <rules>
            <name>Multiple_Addresses_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Counter</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Error_Variable_To_True</targetReference>
            </connector>
            <label>Multiple Addresses Selected</label>
        </rules>
        <rules>
            <name>No_Address_Selected</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>tableOutputAddress.Address_1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>tableOutputAddress.Address_1__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Error_Variable_To_True</targetReference>
            </connector>
            <label>No Address Selected</label>
        </rules>
    </decisions>
    <description>KD-2237 Auto Layout and API Version update</description>
    <environments>Default</environments>
    <formulas>
        <name>Address1</name>
        <dataType>String</dataType>
        <expression>IF({!tableOutputAddress.Address_1__c}=&quot;null&quot;,null,{!tableOutputAddress.Address_1__c})</expression>
    </formulas>
    <formulas>
        <name>Address2</name>
        <dataType>String</dataType>
        <expression>IF({!tableOutputAddress.Address_2__c}=null,&quot;&quot;,{!tableOutputAddress.Address_2__c})</expression>
    </formulas>
    <formulas>
        <name>sameBillAndShipFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(OR({!Select_an_existing_address_bill}={!BillingAndShippingAddress},
{!skipShipping}),true, false)</expression>
    </formulas>
    <interviewLabel>OCAPI Address Table {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OCAPI Address Table</label>
    <loops>
        <description>Because the data table outputs a record collection variable, even though there is only one selected, we have to loop through it to get to the Billing Address.</description>
        <name>Set_Selected_Address_to_Billing_Address</name>
        <label>Set Selected Address to Billing Address</label>
        <locationX>490</locationX>
        <locationY>458</locationY>
        <assignNextValueToReference>eachAddress</assignNextValueToReference>
        <collectionReference>selectedAddressRow</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Return_Address</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>No_Address_Selected_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
