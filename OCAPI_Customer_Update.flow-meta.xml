    <formulas>
        <name>CurrentTaxExemptStatus</name>
        <dataType>String</dataType>
        <expression>IF({!varWebProfile.Tax_Exempt_Number__c}=&quot;&quot;,&quot;Not Tax Exempt&quot;,&quot;Tax Exempt&quot;)</expression>
    </formulas>
    <formulas>
        <name>letterCountAccountId</name>
