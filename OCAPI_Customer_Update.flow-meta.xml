        <expression>Len({!AccountID_Input})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>WP phone stripped of non numeric characters.  This can likely be replaced using a transform element after Winter &apos;24</description>
        <name>UnformattedPhone</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!varWebProfile.Phone__c}, &apos;-&apos;, &apos;&apos;), &apos;(&apos;, &apos;&apos;), &apos;)&apos;, &apos;&apos;), &apos; &apos;, &apos;&apos;),&apos;.&apos;, &apos;&apos;), &apos;+&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>WebProfileAccount</name>
        <dataType>String</dataType>
        <expression>IF({!varWebProfile.Account__c}= &quot;&quot;,{!AccountID_Input},{!varWebProfile.Account__c})</expression>
    </formulas>
    <formulas>
        <name>WebProfileAccountIsNull</name>
        <dataType>Boolean</dataType>
        <expression>IF(OR({!varWebProfile.Account__c}=&quot;&quot;, ISBLANK({!varWebProfile.Account__c})),TRUE, FALSE)</expression>
    </formulas>
