<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <assignments>
        <description>OCAPI Flows use a Web Profile record variable to store the customer information.  We initialize that variable with the Contact info so we can pass it into the OCAPI flows.</description>
        <name>Set_Web_Profile_Info</name>
        <label>Set Web Profile Info</label>
        <locationX>550</locationX>
        <locationY>191</locationY>
        <assignmentItems>
            <assignToReference>varWebProfile.First_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_Contact_Info.FirstName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Last_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_Contact_Info.LastName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_Contact_Info.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Phone__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_Contact_Info.HomePhone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_Contact_Info.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ContactName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ContactNameFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWebProfile.Account_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Donation_Order_only</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>PaymentSelection_CreditCard</name>
        <choiceText>Credit Card</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Credit Card</stringValue>
        </value>
    </choices>
    <choices>
        <name>PaymentSelection_Echeck</name>
        <choiceText>Echeck</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Echeck</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Donation_Order_only</name>
        <label>Donation Order only</label>
        <locationX>719</locationX>
        <locationY>193</locationY>
        <defaultConnector>
            <targetReference>OCAPI_Operator</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Order</defaultConnectorLabel>
        <rules>
            <name>Yes_OnlyDonation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OrderType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Donation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_of_Payment</targetReference>
            </connector>
            <label>Yes_OnlyDonation</label>
        </rules>
    </decisions>
    <decisions>
        <name>Type_of_Payment_being_used</name>
        <label>Type of Payment being used?</label>
        <locationX>1176</locationX>
        <locationY>262</locationY>
        <defaultConnector>
            <targetReference>OCAPI_Operator</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Echeck</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Payment_Method</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PaymentSelection_Echeck</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Echeck_Order_Operator</targetReference>
            </connector>
            <label>Echeck</label>
        </rules>
    </decisions>
    <description>DCI-658 New Echeck Donations</description>
    <formulas>
        <name>ContactNameFormula</name>
        <dataType>String</dataType>
        <expression>{!Lookup_Contact_Info.FirstName} &amp; &quot; &quot; &amp; {!Lookup_Contact_Info.LastName}</expression>
    </formulas>
    <interviewLabel>OCAPI Launch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OCAPI Launch</label>
    <processMetadataValues>
