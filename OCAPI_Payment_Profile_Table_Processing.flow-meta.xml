        </defaultConnector>
        <defaultConnectorLabel>Default - Payment Selected</defaultConnectorLabel>
        <rules>
            <name>Multiple_Payments_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Counter</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
