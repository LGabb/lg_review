            </connector>
            <label>Multiple Payments Selected</label>
        </rules>
        <rules>
            <name>No_Payment_Selected</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>TableOutputPaymentProfile.Credit_Card_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TableOutputPaymentProfile.Credit_Card_Type__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Error_Variable_to_True</targetReference>
            </connector>
            <label>No Payment Selected</label>
        </rules>
    </decisions>
